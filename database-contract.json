{
  "schemaVersion": "1.2",
  "scope": "EU",
  "countryFrontend": {
    "domain": "studentbnb.fr",
    "countryCode": "FR",
    "locale": "fr-FR",
    "currency": "EUR"
  },
  "recordIsolation": "Every market record requires country_code; access policies and analytics must filter by it.",
