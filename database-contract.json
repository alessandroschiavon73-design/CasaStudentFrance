    "POST /api/v1/auth/email/confirm",
    "GET /api/v1/countries/{countryCode}/cities",
    "GET /api/v1/listings?country=FR&city_id={cityId}",
    "GET /api/v1/listings/{id}",
    "POST /api/v1/listings",
    "GET /api/v1/student-requests?country=FR",
    "POST /api/v1/student-requests",
    "POST /api/v1/reports",
    "POST /api/v1/events"
  ],
  "statusFlows": {
    "listing": [
      "draft",
      "email_pending",
      "pending_review",
      "published",
      "suspended",
      "expired"
    ],
    "student_request": [
      "draft",
      "email_pending",
      "pending_review",
      "published",
      "suspended",
      "expired"
    ]
